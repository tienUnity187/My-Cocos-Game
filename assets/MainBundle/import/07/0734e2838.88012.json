8,0]],[6,"Img-002",33554432,55,[[2,-402,[0,"04vtqZYwdNe5hzrdO0MosI"],[5,150,42]],[8,-403,[0,"c4lUEkakxIDJjuVGifmoJv"]]],[1,"6fKSMv8wRBSJloFFnZOtwz",null,null,null,1,0],[1,0,-68.01799999999969,0]],[6,"Img-003",33554432,56,[[2,-404,[0,"09qtreGyVBc5SuQZEKIVuU"],[5,106,42]],[8,-405,[0,"3bp9ykLD9IJZV5Bj/3Jynk"]]],[1,"b3SgJtuutEdKysgjnUQTT9",null,null,null,1,0],[1,0,-68.01799999999957,0]],[17,"Title",1,1,false,11,[0,"13JjoYuH1EfoWSCgBOoahM"],[4,4281388543]],[61,"Before the base game reel spin initiates, a number of positions are replaced with any one symbol except <img src = '10' height=50 offset=-8 /> and <img src = '11' height=50 offset=-8/> .\nOnly highest winner paid per winning combination.\nWinning combinations may contain only one symbol from each adjacent reel, beginning with the leftmost reel.\nLike symbols, or their substitute, on a single reel are not part of the same winning combination, but may create separate winning combinations.\nAll ways wins are multiplied by the bet multiplier.",1,1,20,900,false,12,[0,"a7H3Dwv4xNG6mL1tO99PcF"]],[17,"WILD/TRAIL\n",1,1,false,24,[0,"e2c3b0OWBEKJ3L7ADi4C9r"],[4,4281388543]],[33,50,"Lumilitaw sa reels 2, 3, at 4 at nagsisilbing WILD \npara sa lahat ng simbolo sa  base game maliban sa  <img src = '13' height=50 offset=20 /> .",1,24,900,false,25,[0,"b7Z7skUN1E25p0ZcQK2mXz"]],[17,"SHOU BONUS\n",1,1,false,26,[0,"e0kiDooK1GzK2myUPuPsmJ"],[4,4281388543]],[33,50,"During the base game, each <img src = '11' height=50 offset=20/> will display a credit value between 10% and 500% of the total bet amount.",1,24,900,false,27,[0,"02Y8YTGCZM6oJupD7yxY4j"]],[17,"UNEXPECTED LUCKY\n",1,1,false,28,[0,"76smr8lrVMoYg+yqlNe//p"],[4,4281388543]],[33,50,"Regardless of the number of <img src = '13' height=50 offset=20/>  collected from the reel result, the Feature Game may be triggered at random. \nIf a lucky event occurs, some symbols appearing on the reels will transform into\n  <img src = '13' height=50 offset=20/>  until the minimum requirement of 6 Shou Symbols for Feature entry is met.\nThe transformed <img src = '13' height=50 offset=20/>  will be assigned a Credit Value based on a random chance, after which the Feature Select screen will be displayed.\nThis lucky event may occur even if no <img src = '13' height=50 offset=20/>  appears in the reel result, and the outcome is determined independently on every spin.",1,24,1000,false,50,[0,"4cXqR0IcJLXKDBoU/ciCDh"]],[17,"FEATURE SELECTION",1,1,false,29,[0,"82esTNgsNKQ58wj5/llyPY"],[4,4281388543]],[23,55,"6 or more scattered   <img src = '13' height=50 offset=0/>  during the base game will award the sum of the values displayed on  <img src = '13' height=50 offset=-5/>  and the Feature Selection.\nIf at least 1 position does not contain <Sprite=11>, then the Feature Selection offers the choice of the Free Games Bonus or the Top Up Bonus.\n<img src = '13' height=50 offset=-5/>  and <img src = '11' height=50 offset=-5/> do not appear during the Free Games Bonus.\n",1,1,20,900,false,30,[0,"6fFUJWVgZJWaYjPMhR+Y1L"]],[23,60,"<color=yellow>5 High Symbols: Free Games Bonus dengan nilai 128 <img src = '10' height=50 offset=5/> , 118 <img src = '9' height=50 offset=5/> , 108 <img src = '8' height=50 offset=5/> , 98 <img src = '7' height=50 offset=5/> , atau 88 <img src = '6' height=50 offset=5/> , atau Top Up Bonus dengan nilai 88 <img src = '6' height=50 offset=5/>  dianugerahkan. <color=white>",1,1,20,900,false,31,[0,"2dGqO6DaRPMqiWXeUiTooO"]],[23,60,"Hanya simbol yang dipilih,<img src = '5' height=70 offset=-5/>  ,<img src = '4' height=70 offset=-5/>  ,<img src = '3' height=70 offset=-5/>  ,<img src = '2' height=70 offset=-5/>  ,<img src = '1' height=70 offset=-5/>  ,<img src = '0' height=70 offset=-5/>  , dan  <img src = '13' height=50 offset=0/>  akan muncul semasa Free Games Bonus.",1,1,20,900,false,32,[0,"07nmJw+5FIdKYX0wBRC4lA"]],[17,"FREE GAMES BONUS",1,1,false,34,[0,"60R0X6b9lLIpgqjXq+HfOU"],[4,4281388543]],[23,80,"6 na free games ang ibinibigay.\nKung may hindi bababa sa 1   <img src = '12' height=50 offset= 15/>   na lumitaw sa screen, ang kabuuan ng lahat ng value na ipinakita sa mga triggering symbol ay ibibigay para sa bawat   <img src = '12' height=50 offset= 15/>   na nasa screen.\nBukod dito, kung available ang Top Up Bonus sa panahon ng Feature Selection, maaaring maibigay ang value na ipinapakita sa Fortune Grand Jackpot meter.\nIsang alternatibong set ng reels ang gagamitin sa panahon ng Free Games Bonus. Ang mga winning combination para sa mga reel na ito ay katulad ng sa base game maliban kung may ibang nakasaad.\nAng   <img src = '12' height=50 offset= 15/>   ay lumilitaw lamang sa reels 2–4 at nagsisilbing WILD para sa lahat ng simbolo maliban sa   <img src = '13' height=50 offset= 15/>  .\nAng “Shou Bonus” sa panahon ng Free Games Bonus ay ang pinagsama-samang gantimpala ng lahat ng \n<img src = '12' height=50 offset= 15/>   at ang kabuuan ng lahat ng value na ipinakita sa bawat   <img src = '13' height=50 offset= 15/>   sa base game.\nAng “Shou Bonus” ay hindi kasama ang anumang jackpot na napanalunan.",1,1,20,900,false,35,[0,"a7dbiSJA1NPIeAKopJTLeB"]],[17,"TOP UP BONUS",1,1,false,37,[0,"78ObE5KzlJ77qMIRqSXeR2"],[4,4281388543]],[23,55,"6 spins are awarded.\nAll <img src = '11' height=50 offset=5/> appearing on the triggering spin are held during the bonus.\nIf 1 or more <img src = '12' height=50 offset=5/> land on screen, each <img src = '12' height=50 offset=5/> will display the sum of all credit values displayed on the triggering symbols.\nAfter all <img src = '12' height=50 offset=5/> have been evaluated, each <img src = '13' height=50 offset=5/> that landed on screen for the current spin is evaluated one at a time.\n<img src = '13' height=50 offset=5/> displays the sum of all credit values currently displayed on held positions.\nEach <img src = '12' height=50 offset=5/> and <img src = '13' height=50 offset=5/> that land will be held for the remainder of the bonus.\nEach spin, if the number of spins played is 12 or fewer, “+1 Spin” may appear on a random position that is not held.\n“+1 Spin” awards 1 additional spin.\nIf all 15 positions are held, the value displayed in the Grand Jackpot meter is awarded.\nRemaining spins will be played only if there is at least 1 position not covered by <img src = '11' height=50 offset=5/> , <img src = '12' height=50 offset=5/> , or <img src = '13' height=50 offset=5/>.\nAll symbols other than “+1 Spin”, <img src = '12' height=50 offset=5/>, and <img src = '13' height=50 offset=5/> appearing on the reels will be grayed out and are not evaluated.\nAn alternate set of reels is used during the Top Up Bonus.\n<img src = '11' height=50 offset=5/> does not appear on the reels during the Top Up Bonus. Bonus spins do not award additional bonuses.",1,1,20,900,false,38,[0,"83hkx+d51NJblt50ujb+OB"]],[17,"JACKPOT BONUS",1,1,false,39,[0,"63AvPCn+pDqpt2YCNwwC8L"],[4,4281388543]],[23,65,"The Jackpot Bonus may be triggered if 1 or more     <img src = '11' height=50 offset=10/>    land on screen during the base game.\nA pick field is displayed with 12     <img src = '16' height=50 offset=10/>   . Picks will reveal one of the available prizes.\nAvailable prizes include the Mini Jackpot, Minor Jackpot, Major Jackpot, and Grand Jackpot.\nPicks are made until 3 matching symbols are revealed, and the value displayed in the corresponding meter is awarded.\nThe accumulation of coins in the bowl increases the chances of triggering the Jackpot Bonus.",1,1,20,950,false,40,[0,"67RedQsg1CioU1KZYdZGlb"]],[17,"FREE GAMES BONUS",1,1,false,42,[0,"8dn7SCOBdNZL0t1Pq3V5q+"],[4,4281388543]],[23,50,"If the same symbol appears at least once on each reel and there are 3 or more in sequence from left to right, it results in a win.\nAll win amounts are multiplied by the base bet.\nAll values are displayed as actual coin wins.\nWhen winning with multiple symbols simultaneously, all win amounts are added together and paid as the total win.\nWinnings from the feature are awarded to the player after the feature ends.\nThe total win from the feature is recorded in the history as the cumulative win of the entire cycle.\nJackpot winnings earned during the feature are recorded in the history.\nThe SPACE and ENTER keys on the keyboard can be used to start or stop the spin.\n\n<color=#fff71f>The theoretical RTP of this game is 96.35%. </color>\n\nIn the event of a malfunction, all bets and pays are void.\n\nThe game's Return to Player (RTP) is guaranteed to be achieved within 100,000,000 rounds of play.",1,1,20,1720.1,false,43,[0,"2dwD6d7sBMtrsc0x+tvHGZ"]],[34,44,[0,"45UCcZXrJBz6SLdNtg92zx"]],[34,45,[0,"64anRgpo5NvpbWELzaMd9+"]],[34,46,[0,"35D+jjmBVCV4zGjz2u3iea"]],[60,"1 / 7",50,50,false,68,[0,"45QCnKq/NL/4nnGosEcwya"]]],0,[0,6,1,0,0,1,0,7,109,0,8,108,0,9,107,0,10,106,0,11,105,0,12,104,0,13,103,0,14,102,0,15,101,0,16,100,0,17,99,0,18,98,0,19,97,0,20,96,0,21,95,0,22,93,0,23,94,0,24,92,0,25,91,0,26,90,0,27,41,0,28,9,0,29,36,0,30,33,0,31,5,0,32,8,0,33,3,0,34,6,0,35,113,0,36,112,0,37,111,0,38,110,0,39,1,0,0,1,0,0,1,0,-1,47,0,-2,6,0,-3,3,0,-4,8,0,-5,5,0,-6,33,0,-7,36,0,-8,9,0,-9,41,0,-10,44,0,-11,45,0,-12,46,0,-13,68,0,0,2,0,0,2,0,0,2,0,0,2,0,-1,80,0,-2,81,0,-3,82,0,-4,83,0,-5,84,0,-6,85,0,0,3,0,0,3,0,-1,24,0,-2,25,0,-3,48,0,-4,26,0,-5,27,0,-6,49,0,0,4,0,0,4,0,-1,18,0,-2,19,0,-3,20,0,-4,21,0,-5,22,0,-6,23,0,0,5,0,0,5,0,-1,29,0,-2,30,0,-3,31,0,-4,32,0,0,6,0,0,6,0,-1,11,0,-2,12,0,-3,7,0,0,7,0,0,7,0,-1,13,0,-2,14,0,-3,15,0,-4,16,0,-5,17,0,0,8,0,0,8,0,-1,28,0,-2,50,0,-3,51,0,0,9,0,0,9,0,-1,39,0,-2,40,0,-3,10,0,0,10,0,-1,52,0,-2,53,0,-3,54,0,-4,55,0,-5,56,0,0,11,0,0,11,0,0,11,0,0,11,0,-5,90,0,0,12,0,0,12,0,-3,91,0,0,12,0,0,12,0,0,13,0,0,13,0,0,13,0,-1,69,0,-2,57,0,0,14,0,0,14,0,0,14,0,-1,70,0,-2,58,0,0,15,0,0,15,0,0,15,0,-1,71,0,-2,59,0,0,16,0,0,16,0,0,16,0,-1,72,0,-2,60,0,0,17,0,0,17,0,0,17,0,-1,73,0,-2,61,0,0,18,0,0,18,0,0,18,0,-1,74,0,-2,62,0,0,19,0,0,19,0,0,19,0,-1,75,0,-2,63,0,0,20,0,0,20,0,0,20,0,-1,76,0,-2,64,0,0,21,0,0,21,0,0,21,0,-1,77,0